{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/**/*.ts",
    "src/types/**/*.d.ts",
    "prisma/seed.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
